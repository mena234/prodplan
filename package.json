    "@vitejs/plugin-rsc": "^0.5.34",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "^17.9.0-beta.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prisma": "6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "^1.0.0-beta.2",
