    "@prisma/client": "6.19.0",
    "better-auth": "^1.7.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@openai/sites-vite-plugin": "^0.2.0",
