{
  "name": "prodplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3016",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3016",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:integration": "tsx scripts/live-demo-qa.ts",
    "format": "prettier --write .",
    "build:sites": "vinext build",
    "dev:sites": "vinext dev --hostname 127.0.0.1 --port 3017",
    "db:generate:sites": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
